{
    "name": "linderp/sulu-base-bundle",
    "description": "Helper classes and functions for sulu",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.2",
        "sulu/sulu": "^3.0.8",
        "symfony/config": "^6.2 | ^7.0",
        "symfony/dependency-injection": "^6.2 | ^7.0",
        "symfony/framework-bundle": "^6.2 | ^7.0",
        "symfony/http-foundation": "^6.2 | ^7.0",
        "symfony/http-kernel": "^6.2 | ^7.0",
        "symfony/intl": "^6.2 | ^7.0",
        "symfony/translation": "^6.2 | ^7.0",
        "symfony/security-core": "^6.4 | ^7.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Linderp\\SuluBaseBundle\\": ""
        }
    },
    "authors": [
        {
            "name": "Pascal Linder",
            "email": "pascal.linder@web-venture.ch"
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true
        }
    }
}
